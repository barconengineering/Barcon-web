# Set the confirmed production HTTPS origin before the launch build.
NEXT_PUBLIC_SITE_URL=
# Keep false for private review; set true only for approved public launch.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Server-only Resend key for the contact form. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Inbox that receives contact form enquiries.
CONTACT_TO_EMAIL=
